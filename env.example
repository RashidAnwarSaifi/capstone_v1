# Copy this file to ".env" and fill in your values.

# Which LLM provider to use: groq (default) | gemini (secondary option)
LLM_PROVIDER=groq

# --- Groq (used when LLM_PROVIDER=groq) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Gemini (used when LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Embeddings (local Hugging Face sentence-transformer model, no API key
# needed - downloads from the HF Hub on first use, then cached on disk).
# If huggingface.co isn't reachable from your network, point HF_ENDPOINT at
# an internal Artifactory Hugging Face proxy instead (see README's Setup).
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# HF_ENDPOINT=https://your-artifactory-host/artifactory/api/huggingfaceML/<repo-key>

# --- RAG tuning ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
MAX_UPLOAD_MB=20